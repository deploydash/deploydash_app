set -eu; MAIN_FILE="/etc/ssh/sshd_config"; MANAGED_FILE="/etc/ssh/sshd_config.d/00-deploydash.conf"; update_sshd_option() { KEY="$1"; VALUE="$2"; if [ "$KEY" = "Port" ]; then sed -i -E '/^[[:space:]]*Port[[:space:]]+/d' "$MAIN_FILE"; fi; case "$KEY" in PermitRootLogin|PasswordAuthentication|KbdInteractiveAuthentication|Port) mkdir -p "$(dirname "$MANAGED_FILE")"; touch "$MANAGED_FILE"; chmod 600 "$MANAGED_FILE"; FILE="$MANAGED_FILE" ;; *) FILE="$MAIN_FILE" ;; esac; if grep -Eq "^[[:space:]#]*${KEY}[[:space:]]+" "$FILE"; then sed -i -E "s|^[[:space:]#]*${KEY}[[:space:]]+.*$|${KEY} ${VALUE}|g" "$FILE"; else printf "\n%s %s\n" "$KEY" "$VALUE" >> "$FILE"; fi; }; verify_sshd_option() { KEY="$1"; VALUE="$2"; KEY_LOWER="$(printf "%s" "$KEY" | tr "[:upper:]" "[:lower:]")"; ACTUAL="$(sshd -T | awk -v key="$KEY_LOWER" '$1 == key {print $2; exit}')"; if [ "$ACTUAL" != "$VALUE" ]; then printf "Effective sshd option %s is %s, expected %s.\n" "$KEY" "${ACTUAL:-missing}" "$VALUE" >&2; exit 1; fi; }; update_sshd_option PermitRootLogin no; sshd -t; verify_sshd_option PermitRootLogin no; systemctl restart ssh || systemctl restart sshd