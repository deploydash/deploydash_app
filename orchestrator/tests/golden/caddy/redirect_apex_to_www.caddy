demo.example.com {
    header {
        -Server
        -Via
        -X-Powered-By
        ?X-Content-Type-Options nosniff
        ?Referrer-Policy strict-origin-when-cross-origin
        ?Permissions-Policy accelerometer=(),autoplay=(),camera=(),display-capture=(),geolocation=(),gyroscope=(),hid=(),magnetometer=(),microphone=(),midi=(),payment=(),publickey-credentials-get=(),screen-wake-lock=(),serial=(),usb=(),xr-spatial-tracking=()
        ?X-Frame-Options SAMEORIGIN
    }
    @deploydash_https protocol https
    header @deploydash_https {
        ?Strict-Transport-Security max-age=31536000;includeSubDomains
    }
    redir https://www.demo.example.com{uri} permanent
}
www.demo.example.com {
    reverse_proxy deploydash_app_demo-app:3000 {
        header_down -Server
        header_down -Via
        header_down -X-Powered-By
    }
    header {
        -Server
        -Via
        -X-Powered-By
        ?X-Content-Type-Options nosniff
        ?Referrer-Policy strict-origin-when-cross-origin
        ?Permissions-Policy accelerometer=(),autoplay=(),camera=(),display-capture=(),geolocation=(),gyroscope=(),hid=(),magnetometer=(),microphone=(),midi=(),payment=(),publickey-credentials-get=(),screen-wake-lock=(),serial=(),usb=(),xr-spatial-tracking=()
        ?X-Frame-Options SAMEORIGIN
    }
    @deploydash_https protocol https
    header @deploydash_https {
        ?Strict-Transport-Security max-age=31536000;includeSubDomains
    }
}
